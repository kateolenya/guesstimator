{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guesstimator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true, // each upload gets its own test link
  "observability": { "enabled": true },

  // One Worker serves the static page and the API.
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Workers AI: no API key, access is through this binding.
  "ai": { "binding": "AI" },

  // Per-IP limit: 5 estimates per minute. Approximate by design (counted per Cloudflare location).
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
